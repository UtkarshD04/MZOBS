# Copy to .env.local for local dev overrides. In production (Render), these
# are set as service env vars instead — see render.yaml (staff-dashboard).

# Backend API base URL for the internal staff/ops portal.
VITE_API_URL=http://localhost:4000/api/staff

# Backend's static file host (uploads, avatars, etc).
VITE_FILE_BASE_URL=http://localhost:4000
