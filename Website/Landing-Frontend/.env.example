# Copy to .env.local for local dev overrides. In production (Render), these
# are set as service env vars instead — see render.yaml (mzobs-landing).

# Deployed URLs of the two portal apps this marketing site links out to.
VITE_EMPLOYEE_APP_URL=http://localhost:5173
VITE_EMPLOYER_APP_URL=http://localhost:5175

# Backend API base URLs — this site signs employees/employers in/up directly
# against the backend, then hands the portal app a token via ?token=.
VITE_EMPLOYER_API_URL=http://localhost:4000/api/employer
VITE_EMPLOYEE_API_URL=http://localhost:4000/api/employee

# Backend's public contact form endpoint.
VITE_CONTACT_API_URL=http://localhost:4000/api/contact

# Google OAuth Web Client ID (Google Cloud Console → Credentials). Must match
# GOOGLE_CLIENT_ID on the backend, since it verifies this as the token audience.
VITE_GOOGLE_CLIENT_ID=
