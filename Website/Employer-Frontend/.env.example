# Copy to .env.local for local dev overrides. In production (Render), these
# are set as service env vars instead — see render.yaml (employer-dashboard).

# Backend API base URL for the employer portal.
VITE_API_URL=http://localhost:4000/api/employer

# Landing-Frontend's deployed URL — sign-in/sign-up happen there, this app
# just links out to it.
VITE_LANDING_URL=http://localhost:5176
