# Copy to .env.local for local dev overrides. In production (Render), these
# are set as service env vars instead — see render.yaml (employee-dashboard).

# Backend API base URL for the employee portal.
VITE_API_URL=http://localhost:4000/api/employee

# Backend's static file host (uploads, avatars, etc).
VITE_FILE_BASE_URL=http://localhost:4000

# Landing-Frontend's deployed URL — sign-in/sign-up happen there, this app
# just links out to it.
VITE_LANDING_URL=http://localhost:5176
